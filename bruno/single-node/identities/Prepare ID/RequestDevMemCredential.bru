meta {
  name: RequestDevMemCredential
  type: http
  seq: 2
}

post {
  url: {{IDHUB_ID_API}}/v1alpha/participants/{{PART_CONT}}/credentials/request
  body: json
  auth: none
}

body:json {
  {
      "issuerDid": "{{ISS_ID}}",
      "credentials": [{
          "format": "VC1_0_JWT",
          "type": "MembershipCredential", 
          "id": "dev-credential-def-1"
      }]
  }
}

script:pre-request {
  req.setHeader("x-api-key", bru.getEnvVar("IH_APIKEY"));
}

settings {
  encodeUrl: true
  timeout: 0
}
