# Set your assigned workshop hostname and individual tunnel token.
CONNECTOR_DOMAIN=teilnehmer01.dataspace-portal.com
CLOUDFLARE_TUNNEL_TOKEN=change-me

# Participant id information (update to your settings)
PARTICIPANT_DID=change-me
PARTICIPANT_CONTEXT_ID=participant
PARTICIPANT_SECRET_ALIAS=participantsecret

# Public EDC endpoints (will be auto-generated, uncomment to overwrite)
#PARTICIPANT_DSP_CALLBACK_ADDRESS=https://<connector-domain>/dsp
#PARTICIPANT_DATAPLANE_PUBLIC_URL=https://<connector-domain>/public

# Public DID information (will be auto-generated, uncomment to overwrite)
#PARTICIPANT_CREDENTIAL_SERVICE_URL=https://<connector-domain>/api/credentials/v1/participants/<participant-context-id>
#PARTICIPANT_ISSUER_SERVICE_URL=https://<connector-domain>/api/issuance/v1beta/participants/<participant-context-id>

# Trusted issuer used for membership credentials.
TRUSTED_ISSUER_DID=did:web:dataspace.tmdt.uni-wuppertal.de:workshop-issuer
MEMBERSHIP_CREDENTIAL_DEFINITION_ID=workshop-membership-v1
MEMBERSHIP_CREDENTIAL_TYPE=https://w3id.org/constructx/credentials/v0.1/MembershipCredential

# Connector connection information
CONNECTOR_MANAGEMENT_API_KEY=change-me
# Management-API is auto generated, uncomment to overwrite
CONNECTOR_MANAGEMENT_API=http://127.0.0.1:29110/management
WALLET_IDENTITY_API=http://localhost:20100/api/identity
VAULT_API=http://localhost:28200
PROTOCOL=dataspace-protocol-http:2025-1

CONNECTOR_ONBOARDING_STATE=.state/participant.json

# Local Docker setup and runtime variables
STACK_NAME=workshop-edc
USE_EDGE_PROXY=false
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me
VAULT_TOKEN=change-me
WALLET_DID_USE_HTTPS=true
# Has to start with YWRtaW4.
WALLET_SUPERUSER_KEY=YWRtaW4.change-me

# TLS configuration for use behind an external proxy.
# Uncomment to disable TLS
TRAEFIK_ENTRYPOINT=web
#TRAEFIK_BIND_ADDRESS=127.0.0.1
#TRAEFIK_HTTP_PORT=8080
#TRAEFIK_HTTPS_PORT=8443
