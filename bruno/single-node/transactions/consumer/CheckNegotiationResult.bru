meta {
  name: CheckNegotiationResult
  type: http
  seq: 3
}

get {
  url: {{MANAGEMENT}}/v3/contractnegotiations/{{negotiation-id}}
  body: none
  auth: apikey
}

headers {
  Accept: application/json
}

auth:apikey {
  key: X-Api-key
  value: {{MANAGEMENT_API_KEY}}
  placement: header
}

script:post-response {
  const contractId = res.getBody()['contractAgreementId']; 
  bru.setEnvVar("contractId", contractId);
}

settings {
  encodeUrl: true
  timeout: 0
}
